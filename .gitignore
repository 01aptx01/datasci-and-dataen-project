.nox/

# Logs & Audit evidence
logs/*
!logs/.gitkeep
!logs/quarantine.csv
!logs/ingestion_runs.jsonl

# Data generated at runtime (keep folder structure via .gitkeep)
data/*
!data/**/.gitkeep

# Temporary & atomic write swap files
*.tmp
*.tmp.parquet

# Local Environment Variables & Secrets
.env
.local.env
*.env

# Operating System & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
.gitkeep
